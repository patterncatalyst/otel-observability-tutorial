{
  "uid": "logs-correlation",
  "title": "Logs & Correlation",
  "tags": ["otel-tutorial", "logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "service_name", "refId": "LokiVariableQueryEditor", "stream": "", "type": 1 },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "type": "textbox",
        "name": "trace_id",
        "label": "trace_id filter (regex; .+ = any trace)",
        "query": ".+",
        "current": { "text": ".+", "value": ".+" }
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Log volume",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Log volume by service (lines/s)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": { "defaults": { "unit": "logps", "custom": { "drawStyle": "bars", "fillOpacity": 50, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum by (service_name) (count_over_time({service_name=~\"$service\"}[$__auto]))", "queryType": "range", "legendFormat": "{{service_name}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Log volume by level (detected_level)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "fieldConfig": { "defaults": { "unit": "logps", "custom": { "drawStyle": "bars", "fillOpacity": 50, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum by (detected_level) (count_over_time({service_name=~\"$service\"}[$__auto]))", "queryType": "range", "legendFormat": "{{detected_level}}", "refId": "A" }
      ]
    },
    {
      "type": "row",
      "title": "Logs ↔ traces (trace_id is structured metadata; click it to open Tempo)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4
    },
    {
      "type": "logs",
      "title": "Logs filtered by trace_id — set $trace_id to one request's id",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 10 },
      "id": 5,
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "{service_name=~\"$service\"} | trace_id=~\"$trace_id\"", "queryType": "range", "refId": "A" }
      ]
    }
  ]
}
