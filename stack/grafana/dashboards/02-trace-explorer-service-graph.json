{
  "uid": "trace-explorer-sg",
  "title": "Trace Explorer & Service Graph",
  "tags": ["otel-tutorial", "traces", "service-graph"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "svc",
        "label": "Service",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(traces_spanmetrics_latency_count, service)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Service graph (Tempo metrics-generator)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "type": "nodeGraph",
      "title": "Service graph — call topology, rates and latency",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        { "datasource": { "type": "tempo", "uid": "tempo" }, "queryType": "serviceMap", "refId": "A" }
      ]
    },
    {
      "type": "row",
      "title": "Span metrics by operation (traces_spanmetrics_*)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "p95 span latency by operation (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "id": 4,
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, service, span_name) (rate(traces_spanmetrics_latency_bucket{service=~\"$svc\"}[$__rate_interval])))", "legendFormat": "{{service}} · {{span_name}}", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Call rate by operation (calls/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "id": 5,
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (service, span_name) (rate(traces_spanmetrics_calls_total{service=~\"$svc\"}[$__rate_interval]))", "legendFormat": "{{service}} · {{span_name}}", "range": true, "refId": "A" }
      ]
    },
    {
      "type": "table",
      "title": "Error-status span operations (STATUS_CODE_ERROR)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 6,
      "options": { "showHeader": true },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (service, span_name) (rate(traces_spanmetrics_calls_total{service=~\"$svc\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))", "format": "table", "instant": true, "refId": "A" }
      ]
    },
    {
      "type": "table",
      "title": "Recent traces (TraceQL) — click a row to open the waterfall",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 7,
      "targets": [
        { "datasource": { "type": "tempo", "uid": "tempo" }, "queryType": "traceql", "query": "{ duration > 0ms }", "limit": 20, "tableType": "traces", "refId": "A" }
      ]
    }
  ]
}
