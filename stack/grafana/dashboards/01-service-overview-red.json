{
  "uid": "svc-overview-red",
  "title": "Service Overview (RED)",
  "tags": ["otel-tutorial", "red", "metrics"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "service",
        "label": "Service (job)",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(http_server_duration_milliseconds_count, job)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "RED — Rate, Errors, Duration (OTel http_server_duration_* + Micrometer http_server_requests_* fallback)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Request rate (req/s) by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (job) (rate(http_server_duration_milliseconds_count{job=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{job}} (otel)", "range": true, "exemplar": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (job) (rate(http_server_requests_milliseconds_count{job=~\"$service\"}[$__rate_interval]))", "legendFormat": "{{job}} (micrometer)", "range": true, "exemplar": true, "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx / total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (job) (rate(http_server_duration_milliseconds_count{job=~\"$service\",http_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum by (job) (rate(http_server_duration_milliseconds_count{job=~\"$service\"}[$__rate_interval])), 1e-9)", "legendFormat": "{{job}} (otel)", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (job) (rate(http_server_requests_milliseconds_count{job=~\"$service\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum by (job) (rate(http_server_requests_milliseconds_count{job=~\"$service\"}[$__rate_interval])), 1e-9)", "legendFormat": "{{job}} (micrometer)", "range": true, "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 (ms) — exemplars link to Tempo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum by (le, job) (rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])))", "legendFormat": "{{job}} p50", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])))", "legendFormat": "{{job}} p95", "range": true, "exemplar": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum by (le, job) (rate(http_server_duration_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])))", "legendFormat": "{{job}} p99", "range": true, "exemplar": true, "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_milliseconds_bucket{job=~\"$service\"}[$__rate_interval])))", "legendFormat": "{{job}} p95 (micrometer)", "range": true, "exemplar": true, "refId": "D" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Orders placed rate by status (orders_placed_total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "id": 5,
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 40, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (status) (rate(orders_placed_total[$__rate_interval]))", "legendFormat": "{{status}}", "range": true, "refId": "A" }
      ]
    }
  ]
}
