# notification-python — Multi-stage UBI 10 Containerfile.
#
# Build context is THIS directory (services/python/notification/), per
# stack/compose.yaml's `build.context: ../services/python/notification`. The
# shared `obs` OTel bootstrap library is vendored into this directory rather
# than referenced from services/python/<other-domain>/ — there is no way for
# a Containerfile to COPY files from outside its own build context without a
# multi-context buildx feature the project's compose file does not use.
# notification needs no gRPC stubs, so there is no proto/ directory here.
#
# Toolchain: uv manages both the Python interpreter (3.14, installed
# standalone — UBI 10 does not yet ship a python-314 stream image) and the
# locked dependency set (uv.lock). The runtime stage runs the app under
# `opentelemetry-instrument` (zero-code auto-instrumentation) layered with
# this service's own manual OTel SDK setup (obs.otel) for the Kafka
# consumer's processing span and the trace-context extraction from message
# headers — see src/obs/kafka_propagation.py.

FROM ghcr.io/astral-sh/uv:0.12.23 AS uv

# ---- Stage 1: Build ---------------------------------------------------------
FROM registry.access.redhat.com/ubi10/ubi-minimal:latest AS build
COPY --from=uv /uv /uvx /usr/local/bin/
RUN microdnf install -y tar gzip findutils ca-certificates && microdnf clean all

# Build at the same absolute path (/app) the runtime stage uses: uv's
# installed console scripts (opentelemetry-instrument, ...) embed an
# absolute shebang to this venv's python, so the build and runtime paths
# must match or those scripts fail to exec after the COPY below.
WORKDIR /app
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    UV_LINK_MODE=copy
RUN uv python install 3.14

COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --locked --python 3.14

# ---- Stage 2: Runtime --------------------------------------------------------
FROM registry.access.redhat.com/ubi10/ubi-minimal:latest

WORKDIR /app

# The uv-managed Python 3.14 interpreter the venv below was built against,
# plus the locked venv itself and the application source (this service's
# package and the vendored `obs` library).
COPY --from=build --chown=1001:0 /opt/uv/python /opt/uv/python
COPY --from=build --chown=1001:0 /app/.venv /app/.venv
COPY --from=build --chown=1001:0 /app/src /app/src

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH="/app/src" \
    PYTHONUNBUFFERED=1 \
    OTEL_SERVICE_NAME=notification-python \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318 \
    OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf \
    OTEL_PROPAGATORS=tracecontext,baggage \
    OTEL_METRICS_EXEMPLAR_FILTER=trace_based \
    OTEL_PYTHON_LOG_CORRELATION=true

USER 1001

ENTRYPOINT ["opentelemetry-instrument", "python", "-m", "notification.worker"]
