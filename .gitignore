# ── Jekyll ──────────────────────────────────────────────────────────────────
_site/
.jekyll-cache/
.jekyll-metadata
vendor/
.bundle/
Gemfile.lock

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
uv.lock.tmp

# Generated gRPC stubs (order/inventory/payment): regenerated by each
# Containerfile's `grpc_tools.protoc` build step from the vendored proto/
# sources — see proto/README.md ("generated code is a build artifact").
services/python/*/src/shop/

# ── Deck toolchain (deck/) ───────────────────────────────────────────────────
# node_modules is reproduced by `npm install` against the pinned package.json;
# the QA render output (deck/qa/) is a throwaway soffice artifact.
deck/node_modules/
deck/qa/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
